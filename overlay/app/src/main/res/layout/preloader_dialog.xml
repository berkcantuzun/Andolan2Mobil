<?xml version="1.0" encoding="utf-8"?>
<!-- Andolan2: tam ekran yukleme katmani (Winlator'in kutulu dialogu yerine) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/andolan2_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:adjustViewBounds="true"
            android:contentDescription="Andolan2"
            android:src="@drawable/andolan2_logo" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="320dp"
            android:layout_height="6dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#E8A33A"
            android:indeterminateTintMode="src_in" />

        <TextView
            android:id="@+id/TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.05"
            android:textColor="#E6D3B0"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
