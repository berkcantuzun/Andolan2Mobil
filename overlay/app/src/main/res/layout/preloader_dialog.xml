<?xml version="1.0" encoding="utf-8"?>
<!-- Andolan2: tam ekran yukleme katmani (Winlator'in kutulu dialogu yerine) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/A2Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/andolan2_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:contentDescription="Andolan2"
            android:src="@drawable/andolan2_logo" />

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:indeterminateTint="#F2B44A" />

        <TextView
            android:id="@+id/TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"
            android:textColor="#E6D3B0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/A2Detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="520dp"
            android:fontFamily="monospace"
            android:textColor="#8C7A60"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/A2Hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:textColor="#7A6A55"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/A2Share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/andolan2_chip"
        android:paddingLeft="14dp"
        android:paddingTop="7dp"
        android:paddingRight="14dp"
        android:paddingBottom="7dp"
        android:text="Kaydı paylaş"
        android:textColor="#F2C66B"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
