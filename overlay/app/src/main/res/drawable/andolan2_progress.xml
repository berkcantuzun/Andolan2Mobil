<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#3A2410" />
            <stroke android:width="1dp" android:color="#5C3A18" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4dp" />
                <gradient android:startColor="#B8661A" android:centerColor="#F2B44A" android:endColor="#FFE08A" android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
